import os
from building import *
Import('RTT_ROOT')

cwd = GetCurrentDir()

src = Glob('*.c')
src += Glob('sdio/*.c')
src += [
    'usbd/drv_usbd_cdc.c',
    'usbd/usb_desc.c',
]

objs = []


inc = [cwd]
inc += [cwd + '/sdio', cwd + '/usbd']

group = DefineGroup('PeripheralDriver', src, depend = [''], CPPPATH = inc)

objs += [group]

Return('objs')
